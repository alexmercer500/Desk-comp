{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "companion",
  "description": "The character's window: its shape and drag, opening the panel, reading settings, and passing on the user's Allow / Deny (the only window that can).",
  "windows": ["companion"],
  "permissions": [
    "core:default",
    "allow-set-hit-rect",
    "allow-drag-begin",
    "allow-drag-end",
    "allow-hop-by",
    "allow-set-room",
    "allow-on-battery",
    "allow-panel-show",
    "allow-panel-hide",
    "allow-get-prefs",
    "allow-answer-permission",
    "allow-answer-question",
    "allow-focus-session"
  ]
}
