# Copy this file to .env (next to package.json) and fill it in before building.
# .env is not in git: everyone who builds Desk Companion uses their own.

# Your relay (docs/RELAY.md): built into the app, so phones can reach this PC
# away from home without pasting an address in Settings. Leave it out to build
# without one (users can still paste their own in Settings -> Phone).
DESK_COMPANION_RELAY=https://desk-companion-relay.<your-name>.workers.dev
